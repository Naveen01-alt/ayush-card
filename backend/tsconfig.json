{
  // Visit https://aka.ms/tsconfig to read more about this file
  "compilerOptions": {
    "module": "Node16",
    "moduleResolution": "node16",
    "target": "esnext",
    "esModuleInterop": true,
    "strict": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "outDir": "./dist",
    "rootDir": "./src"
  },
  "include": ["src/**/*"]
}
